<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="8dp">

        <!-- Row 1 -->
        <Button android:id="@+id/btnLeftParen" style="@style/ButtonFunction" android:text="("
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <Button android:id="@+id/btnRightParen" style="@style/ButtonFunction" android:text=")"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toEndOf="@id/btnLeftParen"/>
        <Button android:id="@+id/btnMC" style="@style/ButtonFunction" android:text="mc"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toEndOf="@id/btnRightParen"/>
        <Button android:id="@+id/btnMPlus" style="@style/ButtonFunction" android:text="m+"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toEndOf="@id/btnMC"/>
        <Button android:id="@+id/btnMMinus" style="@style/ButtonFunction" android:text="m-"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toEndOf="@id/btnMPlus"/>
        <Button android:id="@+id/btnMR" style="@style/ButtonFunction" android:text="mr"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toEndOf="@id/btnMMinus"/>

        <!-- Row 2 -->
        <Button android:id="@+id/btnPower2" style="@style/ButtonFunction" android:text="x²"
            app:layout_constraintTop_toBottomOf="@id/btnLeftParen"
            android:layout_marginTop="8dp"
            app:layout_constraintStart_toStartOf="parent"/>
        <Button android:id="@+id/btnPower3" style="@style/ButtonFunction" android:text="x³"
            app:layout_constraintTop_toBottomOf="@id/btnRightParen"
            app:layout_constraintStart_toEndOf="@id/btnPower2"
            android:layout_marginTop="8dp"/>
        <Button android:id="@+id/btnPowerX" style="@style/ButtonFunction" android:text="xʸ"
            app:layout_constraintTop_toBottomOf="@id/btnMC"
            app:layout_constraintStart_toEndOf="@id/btnPower3"
            android:layout_marginTop="8dp"/>
        <Button android:id="@+id/btnPowerE" style="@style/ButtonFunction" android:text="eˣ"
            app:layout_constraintTop_toBottomOf="@id/btnMPlus"
            app:layout_constraintStart_toEndOf="@id/btnPowerX"
            android:layout_marginTop="8dp"/>
        <Button android:id="@+id/btnPower10" style="@style/ButtonFunction" android:text="10ˣ"
            app:layout_constraintTop_toBottomOf="@id/btnMMinus"
            app:layout_constraintStart_toEndOf="@id/btnPowerE"
            android:layout_marginTop="8dp"/>

        <!-- Row 3 -->
        <Button android:id="@+id/btnInverse" style="@style/ButtonFunction" android:text="1/x"
            app:layout_constraintTop_toBottomOf="@id/btnPower2"
            android:layout_marginTop="8dp"
            app:layout_constraintStart_toStartOf="parent"/>
        <Button android:id="@+id/btnSqrt" style="@style/ButtonFunction" android:text="√x"
            app:layout_constraintTop_toBottomOf="@id/btnPower3"
            app:layout_constraintStart_toEndOf="@id/btnInverse"
            android:layout_marginTop="8dp"/>
        <Button android:id="@+id/btnCbrt" style="@style/ButtonFunction" android:text="³√x"
            app:layout_constraintTop_toBottomOf="@id/btnPowerX"
            app:layout_constraintStart_toEndOf="@id/btnSqrt"
            android:layout_marginTop="8dp"/>
        <Button android:id="@+id/btnRootX" style="@style/ButtonFunction" android:text="ʸ√x"
            app:layout_constraintTop_toBottomOf="@id/btnPowerE"
            app:layout_constraintStart_toEndOf="@id/btnCbrt"
            android:layout_marginTop="8dp"/>
        <Button android:id="@+id/btnLog" style="@style/ButtonFunction" android:text="log"
            app:layout_constraintTop_toBottomOf="@id/btnPower10"
            app:layout_constraintStart_toEndOf="@id/btnRootX"
            android:layout_marginTop="8dp"/>

        <!-- Row 4 -->
        <Button android:id="@+id/btnSin" style="@style/ButtonFunction" android:text="sin"
            app:layout_constraintTop_toBottomOf="@id/btnInverse"
            android:layout_marginTop="8dp"
            app:layout_constraintStart_toStartOf="parent"/>
        <Button android:id="@+id/btnCos" style="@style/ButtonFunction" android:text="cos"
            app:layout_constraintTop_toBottomOf="@id/btnSqrt"
            app:layout_constraintStart_toEndOf="@id/btnSin"
            android:layout_marginTop="8dp"/>
        <Button android:id="@+id/btnTan" style="@style/ButtonFunction" android:text="tan"
            app:layout_constraintTop_toBottomOf="@id/btnCbrt"
            app:layout_constraintStart_toEndOf="@id/btnCos"
            android:layout_marginTop="8dp"/>
        <Button android:id="@+id/btnSinh" style="@style/ButtonFunction" android:text="sinh"
            app:layout_constraintTop_toBottomOf="@id/btnRootX"
            app:layout_constraintStart_toEndOf="@id/btnTan"
            android:layout_marginTop="8dp"/>
        <Button android:id="@+id/btnCosh" style="@style/ButtonFunction" android:text="cosh"
            app:layout_constraintTop_toBottomOf="@id/btnLog"
            app:layout_constraintStart_toEndOf="@id/btnSinh"
            android:layout_marginTop="8dp"/>

        <!-- Row 5 -->
        <Button android:id="@+id/btnTanh" style="@style/ButtonFunction" android:text="tanh"
            app:layout_constraintTop_toBottomOf="@id/btnSin"
            android:layout_marginTop="8dp"
            app:layout_constraintStart_toStartOf="parent"/>
        <Button android:id="@+id/btnE" style="@style/ButtonFunction" android:text="e"
            app:layout_constraintTop_toBottomOf="@id/btnCos"
            app:layout_constraintStart_toEndOf="@id/btnTanh"
            android:layout_marginTop="8dp"/>
        <Button android:id="@+id/btnPi" style="@style/ButtonFunction" android:text="π"
            app:layout_constraintTop_toBottomOf="@id/btnTan"
            app:layout_constraintStart_toEndOf="@id/btnE"
            android:layout_marginTop="8dp"/>
        <Button android:id="@+id/btnEE" style="@style/ButtonFunction" android:text="EE"
            app:layout_constraintTop_toBottomOf="@id/btnSinh"
            app:layout_constraintStart_toEndOf="@id/btnPi"
            android:layout_marginTop="8dp"/>
        <Button android:id="@+id/btnFactorial" style="@style/ButtonFunction" android:text="x!"
            app:layout_constraintTop_toBottomOf="@id/btnCosh"
            app:layout_constraintStart_toEndOf="@id/btnEE"
            android:layout_marginTop="8dp"/>

        <!-- Row 6 -->
        <Button android:id="@+id/btnRand" style="@style/ButtonFunction" android:text="Rand"
            app:layout_constraintTop_toBottomOf="@id/btnTanh"
            android:layout_marginTop="8dp"
            app:layout_constraintStart_toStartOf="parent"/>
        <Button android:id="@+id/btnLn" style="@style/ButtonFunction" android:text="ln"
            app:layout_constraintTop_toBottomOf="@id/btnE"
            app:layout_constraintStart_toEndOf="@id/btnRand"
            android:layout_marginTop="8dp"/>
        <Button android:id="@+id/btnRad" style="@style/ButtonFunction" android:text="Rad"
            app:layout_constraintTop_toBottomOf="@id/btnPi"
            app:layout_constraintStart_toEndOf="@id/btnLn"
            android:layout_marginTop="8dp"/>

        <!-- Row 7: delete/AC/%/÷ -->
        <Button android:id="@+id/btnDeleteSci" style="@style/ButtonFunction" android:text="⌫"
            app:layout_constraintTop_toBottomOf="@id/btnRand"
            android:layout_marginTop="12dp"
            app:layout_constraintStart_toStartOf="parent"/>
        <Button android:id="@+id/btnACSci" style="@style/ButtonFunction" android:text="AC"
            app:layout_constraintTop_toBottomOf="@id/btnLn"
            app:layout_constraintStart_toEndOf="@id/btnDeleteSci"
            android:layout_marginTop="12dp"/>
        <Button android:id="@+id/btnPercentSci" style="@style/ButtonFunction" android:text="%"
            app:layout_constraintTop_toBottomOf="@id/btnRad"
            app:layout_constraintStart_toEndOf="@id/btnACSci"
            android:layout_marginTop="12dp"/>
        <Button android:id="@+id/btnDivideSci" style="@style/ButtonOperator" android:text="÷"
            app:layout_constraintTop_toBottomOf="@id/btnPercentSci"
            app:layout_constraintStart_toEndOf="@id/btnPercentSci"
            android:layout_marginTop="12dp"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
